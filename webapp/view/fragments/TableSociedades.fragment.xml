<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Table inset="false" width="auto" class="sapUiResponsiveMargin" noDataText="{i18n>noCompanyCodes}">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>companyCodesTitle}" level="H2"/>
                <ToolbarSpacer/>
                <Button id="btnAddSociedad" icon="sap-icon://add" press=".onOpenAddProgramsDialog"/>
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>companyCodeLabel}" />
            </Column>
            <Column>
                <Text text="{i18n>descriptionColumn}" />
            </Column>
            <Column hAlign="Right" visible="{= ${EditModel>/editMode} }"/>
        </columns>

        <items>
            <ColumnListItem vAlign="Middle">
                <cells>
                    <Text text="{Programas>sociedad}" />
                    <Text text="{Programas>descripcion}" />

                    <Button id="btnDeleteSociedad" icon="sap-icon://delete" type="Transparent" press=".onDeleteRow"/>

                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>