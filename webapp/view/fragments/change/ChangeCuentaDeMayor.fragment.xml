<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm
            width="auto"
            class="sapUiResponsiveMargin"
			layout="ColumnLayout"
			title="Cuenta de Mayor" >
			<f:content>
				<Label text="No. de Cuenta" />
				<Input
					id="inputCuentaMayor"
					width="auto"
					showValueHelp="true"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="7"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="Sociedad" />
				<Input
					id="inputSociedad"
					width="auto"
					showValueHelp="true"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="8"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="Texto Breve" />
				<Input value="{CuentaMayorData>/TXT20}"/>

				<Label text="Texto Explicativo" />
				<Input value="{CuentaMayorData>/TXT50}"/>
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>