<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm
            width="auto"
            class="sapUiResponsiveMargin"
			layout="ColumnLayout"
			title="{i18n>accountTitle}" >
			<f:content>
				<Label text="{i18n>accountNumberLabel}" />
				<Input
					id="inputCuentaMayor"
					width="auto"
					showValueHelp="true"
					liveChange=".onEditSelectionLiveChange"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="7"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="{i18n>companyCodeLabel}" />
				<Input
					id="inputSociedad"
					width="auto"
					showValueHelp="true"
					liveChange=".onEditSelectionLiveChange"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="8"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="{i18n>shortTextLabel}" />
				<Input value="{CuentaMayorData>/TXT20}"/>

				<Label text="{i18n>longTextLabel}" />
				<Input value="{CuentaMayorData>/TXT50}"/>
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>