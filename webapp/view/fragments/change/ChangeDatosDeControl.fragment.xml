<core:FragmentDefinition xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <f:SimpleForm width="auto" class="sapUiResponsiveMargin" layout="ColumnLayout" title="Datos de Control">

        <f:content>
            <!-- ========================= -->
            <!-- Control de Cuenta -->
            <!-- ========================= -->

            <Toolbar>
                <Title text="Control de Cuenta en Sociedad"/>
            </Toolbar>

            <Label text="Moneda de la Cuenta"/>
            <Input id="inputMonedaCuenta"
                value="{parts: ['CuentaMayorData>/WAERS', {path: 'descripcionesCatalogo>/15', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="15"/>
                    <core:CustomData key="campoSAP" value="WAERS"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/WAERS}"/>
                </customData>
            </Input>

            <Label text="Saldos en Moneda Local"/>
            <CheckBox selected="{CuentaMayorData>/XSALH}"/>

            <Label text="Categoría Fiscal"/>
            <Input id="inputCategoriaFiscal"
                value="{parts: ['CuentaMayorData>/MWSKZ', {path: 'descripcionesCatalogo>/16', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="16"/>
                    <core:CustomData key="campoSAP" value="MWSKZ"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/MWSKZ}"/>
                </customData>
            </Input>

            <Label text="Permitir Contab. Sin IVA"/>
            <CheckBox selected="{CuentaMayorData>/XMWNO}"/>

            <Label text="Cta. Asociada p/Clas Cta"/>
            <Input id="inputCtaAsociadaClasCta"
                value="{parts: ['CuentaMayorData>/MITKZ', {path: 'descripcionesCatalogo>/17', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="17"/>
                    <core:CustomData key="campoSAP" value="MITKZ"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/MITKZ}"/>
                </customData>
            </Input>

            <!-- ========================= -->
            <!-- Gestión de Cuenta -->
            <!-- ========================= -->

            <Toolbar>
                <Title text="Gestión de Cta en Sociedad"/>
            </Toolbar>

            <Label text="Gestión Partidas Abiertas"/>
            <CheckBox selected="{CuentaMayorData>/XOPVW}"/>

            <Label text="Visualización Partidas Indiv."/>
            <CheckBox selected="{CuentaMayorData>/XKRES}"/>

            <Label text="Clave Clasificación"/>
            <Input id="inputClaveClasificacion"
                value="{parts: ['CuentaMayorData>/ZUAWA', {path: 'descripcionesCatalogo>/18', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="18"/>
                    <core:CustomData key="campoSAP" value="ZUAWA"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/ZUAWA}"/>
                </customData>
            </Input>
        </f:content>

    </f:SimpleForm>
</core:FragmentDefinition>