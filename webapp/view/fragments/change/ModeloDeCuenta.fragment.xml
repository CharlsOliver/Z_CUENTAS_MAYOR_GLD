<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm id="SimpleFormChange354"
			editable="true"
			width="auto"
			layout="ResponsiveGridLayout"
            class="sapUiResponsiveMargin"
			title="{i18n>referenceAccountTitle}"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="{i18n>accountNumberLabel}" />
				<Input
					id="inputCuentaMayorModelo"
					width="auto"
					showValueHelp="true"
					change=".onCuentaModeloChange"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="7"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="{i18n>companyCodeLabel}" />
				<Input
					id="inputSociedadModelo"
					width="auto"
					showValueHelp="true"
					change=".onCuentaModeloChange"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="8"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>
