<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm
            width="auto"
            class="sapUiResponsiveMargin"
			layout="ColumnLayout"
			title="Tipo/Descripción" >
			<f:content>
				<Label text="Grupo de Cuentas" />
				<Input showValueHelp="true"/>

				<Label text="Cta Beneficios / Cta Balance" />
				<Select forceSelection="true">
					<core:ListItem key="Beneficios" text="Beneficios" />
					<core:ListItem key="Balance" text="Balance" />
				</Select>

				<Label text="Sociedad GL Asociada" />
				<Input showValueHelp="true"/>

				<Label text="No.Cuenta de Grupo" />
				<Input showValueHelp="true"/>
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>