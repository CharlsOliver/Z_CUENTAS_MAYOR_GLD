<core:FragmentDefinition xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <f:SimpleForm width="auto" class="sapUiResponsiveMargin" layout="ColumnLayout" title="{i18n>bankDataTitle}">

        <f:content>
            <!-- ===================================== -->
            <!-- Control De Entrada de Doc en Sociedad -->
            <!-- ===================================== -->

            <Toolbar>
                <Title text="{i18n>documentEntryTitle}"/>
            </Toolbar>

            <Label text="{i18n>fieldStatusGroupLabel}"/>
            <Input id="inputGrupoEstatusCampos"
                value="{parts: ['CuentaMayorData>/FSTAG', {path: 'descripcionesCatalogo>/19', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="19"/>
                    <core:CustomData key="campoSAP" value="FSTAG"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/FSTAG}"/>
                </customData>
            </Input>

            <Label text="{i18n>automaticPostingLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XINTB}"/>

            <!-- =========================== -->
            <!-- Datos Bancarios/Financieros -->
            <!-- =========================== -->

            <Toolbar>
                <Title text="{i18n>financialDataTitle}"/>
            </Toolbar>

            <Label text="{i18n>planningLevelLabel}"/>
            <Input id="inputNivelTesoreria"
                value="{parts: ['CuentaMayorData>/FDLEV', {path: 'descripcionesCatalogo>/20', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="20"/>
                    <core:CustomData key="campoSAP" value="FDLEV"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/FDLEV}"/>
                </customData>
            </Input>

            <Label text="{i18n>cashFlowRelevantLabel}"/>
            <CheckBox/>

            <Label text="{i18n>commitmentItemLabel}"/>
            <Input id="inputPosPresupuestaria"
                value="{parts: ['CuentaMayorData>/FIPOS', {path: 'descripcionesCatalogo>/21', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="21"/>
                    <core:CustomData key="campoSAP" value="FIPOS"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/FIPOS}"/>
                </customData>
            </Input>

            <Label text="{i18n>houseBankLabel}"/>
            <Input id="inputBancoPropio"
                value="{parts: ['CuentaMayorData>/HBKID', {path: 'descripcionesCatalogo>/22', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="22"/>
                    <core:CustomData key="campoSAP" value="HBKID"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/HBKID}"/>
                </customData>
            </Input>

            <Label text="{i18n>houseBankAccountIdLabel}"/>
            <Input id="inputIdBancoPropio"
                value="{parts: ['CuentaMayorData>/HKTID', {path: 'descripcionesCatalogo>/23', targetType: 'any'}], formatter: '.formatCatalogo'}"
                change=".onCampoCatalogoChange"
                showValueHelp="true" valueHelpRequest=".onCatalogoValueHelp">
                <customData>
                    <core:CustomData key="catalogo" value="23"/>
                    <core:CustomData key="campoSAP" value="HKTID"/>
                    <core:CustomData key="valorSeleccionado" value="{CuentaMayorData>/clavesCatalogo/HKTID}"/>
                </customData>
            </Input>

            <Label text="{i18n>bankAccountLabel}"/>
            <Input/>
        </f:content>

    </f:SimpleForm>
</core:FragmentDefinition>