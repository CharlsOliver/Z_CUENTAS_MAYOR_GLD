<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="vhCatalogo"
        title="{i18n>valueHelpTitle}"
        noDataText="{i18n>noCatalogRecords}"
        search=".onCatalogoSearch"
        liveChange=".onCatalogoSearch"
        confirm=".onCatalogoConfirm"
        cancel=".onCatalogoCancel"
        growing="true"
        growingThreshold="20"
        rememberSelections="false"
        items="{
            path: 'ZSERV_GLD_SHELP_SRV>/InputSet',
            events: {dataReceived: '.onCatalogoDataReceived'}
        }">

        <StandardListItem
            title="{ZSERV_GLD_SHELP_SRV>Valor}"
            description="{ZSERV_GLD_SHELP_SRV>Descripcion}"/>

    </SelectDialog>

</core:FragmentDefinition>