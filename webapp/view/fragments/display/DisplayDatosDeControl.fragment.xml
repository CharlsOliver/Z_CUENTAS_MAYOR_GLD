<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <f:SimpleForm
        editable="false"
        width="auto"
        class="sapUiResponsiveMargin"
        title="{i18n>controlDataTitle}"
        labelSpanXL="4"
        labelSpanL="6"
        labelSpanM="6"
        labelSpanS="6"
        adjustLabelSpan="true"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="2"
        columnsL="2"
        columnsM="2"
        singleContainerFullSize="true" >

        <f:content>
            <!-- ========================= -->
            <!-- Control de Cuenta -->
            <!-- ========================= -->

            <Toolbar>
                <Title text="{i18n>companyCodeControlTitle}"/>
            </Toolbar>

            <Label text="{i18n>accountCurrencyLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/WAERS', {path: 'descripcionesCatalogo>/15', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>localCurrencyBalanceLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XSALH}" editable="false"/>

            <Label text="{i18n>taxCategoryLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/MWSKZ', {path: 'descripcionesCatalogo>/16', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>postingWithoutTaxLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XMWNO}" editable="false"/>

            <Label text="{i18n>reconciliationAccountLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/MITKZ', {path: 'descripcionesCatalogo>/17', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <!-- ========================= -->
            <!-- Gestión de Cuenta -->
            <!-- ========================= -->

            <Toolbar>
                <Title text="{i18n>companyCodeManagementTitle}"/>
            </Toolbar>

            <Label text="{i18n>openItemManagementLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XOPVW}" editable="false"/>

            <Label text="{i18n>lineItemDisplayLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XKRES}" editable="false"/>

            <Label text="{i18n>sortKeyLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/ZUAWA', {path: 'descripcionesCatalogo>/18', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>