<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <f:SimpleForm
        width="auto"
        editable="false"
        class="sapUiResponsiveMargin"
        layout="ResponsiveGridLayout"
        title="{i18n>bankDataTitle}"
        labelSpanXL="4"
        labelSpanL="5"
        labelSpanM="5"
        labelSpanS="6"
        adjustLabelSpan="true"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="2"
        columnsL="2"
        columnsM="2"
        singleContainerFullSize="false" >
        <f:content>
            <!-- ===================================== -->
            <!-- Control De Entrada de Doc en Sociedad -->
            <!-- ===================================== -->

            <Toolbar>
                <Title text="{i18n>documentEntryTitle}"/>
            </Toolbar>

            <Label text="{i18n>fieldStatusGroupLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/FSTAG', {path: 'descripcionesCatalogo>/19', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>automaticPostingLabel}"/>
            <CheckBox selected="{CuentaMayorData>/XINTB}" editable="false"/>

            <!-- =========================== -->
            <!-- Datos Bancarios/Financieros -->
            <!-- =========================== -->

            <Toolbar>
                <Title text="{i18n>financialDataTitle}"/>
            </Toolbar>

            <Label text="{i18n>planningLevelLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/FDLEV', {path: 'descripcionesCatalogo>/20', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>cashFlowRelevantLabel}"/>
            <Text />

            <Label text="{i18n>commitmentItemLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/FIPOS', {path: 'descripcionesCatalogo>/21', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>houseBankLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/HBKID', {path: 'descripcionesCatalogo>/22', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>houseBankAccountIdLabel}"/>
            <Text text="{parts: ['CuentaMayorData>/HKTID', {path: 'descripcionesCatalogo>/23', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

            <Label text="{i18n>bankAccountLabel}"/>
            <Text />
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>