<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm
            width="auto"
            class="sapUiResponsiveMargin"
			layout="ColumnLayout"
			title="Cuenta de Mayor" >
			<f:content>
				<Label text="No. de Cuenta" />
				<Input 
					id="inputDisplayCuentaMayor"
					width="auto"
					showValueHelp="true"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="7"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="Sociedad" />
				<Input 
					id="inputDisplaySociedad"
					width="auto"
					showValueHelp="true"
					valueHelpRequest=".onCatalogoValueHelp">
					<customData>
						<core:CustomData key="catalogo" value="8"/>
						<core:CustomData key="valorSeleccionado" value=""/>
					</customData>
				</Input>

				<Label text="Texto Breve" />
				<Text text="IEPS pendiente Pagar" />

				<Label text="Texto Explicativo" />
				<Text text="IEPS pendiente Pagar" />
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>