<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">

    <f:SimpleForm
        width="auto"
        editable="false"
        layout="ResponsiveGridLayout"
        class="sapUiResponsiveMargin"
        title="{i18n>blocksTitle}"
        labelSpanXL="6"
        labelSpanL="6"
        labelSpanM="4"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="2"
        columnsL="2"
        columnsM="2"
        singleContainerFullSize="false" >
        <f:content>
            <core:Title text="{i18n>blockTitle}" />
            <Label text="{i18n>blockedForCreationLabel}" />
            <Text />
            <Label text="{i18n>blockedForPostingLabel}" />
            <Text />
            <Label text="{i18n>blockedForPlanningLabel}" />
            <Text />

            <core:Title text="{i18n>companyCodeBlockTitle}" />
            <Label text="{i18n>companyCodePostingBlockLabel}" />
            <Text />

            <core:Title text="{i18n>additionalInformationTitle}" />
            <Label text="{i18n>blockReasonLabel}" />
            <Text />
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>