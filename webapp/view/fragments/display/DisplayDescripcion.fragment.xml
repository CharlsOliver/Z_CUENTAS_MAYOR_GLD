<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
        <f:SimpleForm
			width="auto"
			editable="false"
			class="sapUiResponsiveMargin"
			layout="ResponsiveGridLayout"
			title="{i18n>accountDescriptionTitle}"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="{i18n>accountGroupLabel}" />
				<Text text="{parts: ['CuentaMayorData>/KTOKS', {path: 'descripcionesCatalogo>/11', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

				<Label text="{i18n>accountTypeLabel}" />
				<Text text="{parts: ['CuentaMayorData>/GVTYP', {path: 'descripcionesCatalogo>/12', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

				<Label text="{i18n>tradingPartnerLabel}" />
				<Text text="{parts: ['CuentaMayorData>/VBUND', {path: 'descripcionesCatalogo>/13', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>

				<Label text="{i18n>groupAccountNumberLabel}" />
				<Text text="{parts: ['CuentaMayorData>/BILKT', {path: 'descripcionesCatalogo>/14', targetType: 'any'}], formatter: '.formatDescripcionCatalogo'}"/>
			</f:content>
		</f:SimpleForm>
</core:FragmentDefinition>