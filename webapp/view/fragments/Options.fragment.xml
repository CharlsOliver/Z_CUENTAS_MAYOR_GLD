<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Panel width="auto" class="sapUiResponsiveMargin">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>optionsTitle}"/>
                <ToolbarSpacer/>
                <Button id="btnEdit" icon="sap-icon://edit" tooltip="{i18n>editButton}" type="Transparent" press=".onEditPress"/>
            </OverflowToolbar>
        </headerToolbar>
        <content>
            <RadioButtonGroup id="operationOptions" columns="5" selectedIndex="0" select=".onOptionSelect">
                <buttons>
                    <RadioButton text="{i18n>createAccountOption}" class='sapUiMediumMarginEnd'/>
                    <RadioButton text="{i18n>createBankAccountOption}" class='sapUiMediumMarginEnd'/>
                    <RadioButton text="{i18n>changeAccountOption}" class='sapUiMediumMarginEnd'/>
                    <RadioButton text="{i18n>blockAccountOption}" class='sapUiMediumMarginEnd'/>
                    <RadioButton text="{i18n>extendAccountOption}" class='sapUiMediumMarginEnd'/>
                </buttons>
            </RadioButtonGroup>
        </content>
    </Panel>
</core:FragmentDefinition>